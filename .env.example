# AI Tutor Environment Configuration

# Application
APP_NAME="AI Tutor"
DEBUG=false
ENV=development
SECRET_KEY=your-secret-key-here

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DB_URL=sqlite:///./data/app.db
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Kimi Code API (推荐！国内访问快，支持长文本和Thinking模式)
# 申请地址：https://www.kimi.com/code
KIMI_API_KEY=your_kimi_api_key
KIMI_MODEL=kimi-for-coding
KIMI_TEMPERATURE=0.7
KIMI_MAX_TOKENS=4096

# Kimi Thinking模式（展示思考过程，适合复杂推理）
# 启用后自动使用 kimi-k2-thinking 模型
KIMI_ENABLE_THINKING=false
KIMI_THINKING_MODEL=kimi-k2-thinking

# Vector Database
VECTOR_PROVIDER=chroma
VECTOR_HOST=localhost
VECTOR_PORT=8000

# Diagnosis
DIAG_TIMEOUT_SECONDS=90
DIAG_CONFIDENCE_THRESHOLD=0.8

# Baidu OCR (免费额度：个人用户每月几万次)
# 申请地址：https://cloud.baidu.com/product/ocr
BAIDU_OCR_ENABLED=false
BAIDU_OCR_API_KEY=your_baidu_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key
BAIDU_OCR_TIMEOUT=30.0

# Google Gemini (推荐！免费额度 generous)
# 1500次/分钟，支持图片理解、题目分析
# 申请地址：https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048
