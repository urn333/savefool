# AI Tutor Environment Configuration

# Application
APP_NAME="AI Tutor"
DEBUG=false
ENV=development
SECRET_KEY=your-secret-key-here

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DB_URL=sqlite:///./data/app.db
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Vector Database
VECTOR_PROVIDER=chroma
VECTOR_HOST=localhost
VECTOR_PORT=8000

# Diagnosis
DIAG_TIMEOUT_SECONDS=90
DIAG_CONFIDENCE_THRESHOLD=0.8

# Baidu OCR (免费额度：个人用户每月几万次)
# 申请地址：https://cloud.baidu.com/product/ocr
BAIDU_OCR_ENABLED=false
BAIDU_OCR_API_KEY=your_baidu_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key
BAIDU_OCR_TIMEOUT=30.0
